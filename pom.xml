<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <name>Worker Globfilter</name>
    <description>Orchestration, Management and Monitoring of Data Processing</description>
    <url>https://jobservice.github.io/job-service/</url>

    <inceptionYear>2017</inceptionYear>

    <parent>
        <groupId>com.github.cafapi</groupId>
        <artifactId>caf-common-parent</artifactId>
        <version>5.0.0-431</version>
    </parent>

    <groupId>com.github.jobservice</groupId>
    <artifactId>worker-globfilter-aggregator</artifactId>
    <packaging>pom</packaging>
    <version>2.3.0-SNAPSHOT</version>
    
    <developers>
        <developer>
            <id>CJComac</id>
            <name>Christopher Comac</name>
            <email>christopher.jam.comac@microfocus.com</email>
        </developer>
        <developer>
            <id>dermot-hardy</id>
            <name>Dermot Hardy</name>
            <email>dermot.hardy@microfocus.com</email>
        </developer>
        <developer>
            <id>michael-bryson</id>
            <name>Michael Bryson</name>
            <email>michael.bryson@microfocus.com</email>
        </developer>
    </developers>

    <properties>
        <caf.worker-framework.version>9.0.0-1293</caf.worker-framework.version>
        <copyrightYear>2026</copyrightYear>
        <copyrightNotice>Copyright ${project.inceptionYear}-${copyrightYear} Open Text.</copyrightNotice>
        <worker-batch-version>5.0.0-SNAPSHOT</worker-batch-version>
        <dockerHubOrganization>jobservice</dockerHubOrganization>
        <dockerJobServiceOrg>${dockerImagePrefix}${dockerHubOrganization}${dockerOrgSeperator}</dockerJobServiceOrg>
        <dockerProjectVersion>${dockerVersionSeperator}${project.version}</dockerProjectVersion>
        <enforceCorrectDependencies>true</enforceCorrectDependencies>
        <projectDockerRegistry>worker-globfilter-${project.version}.project-registries.local</projectDockerRegistry>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github.workerframework</groupId>
                <artifactId>worker-framework-aggregator</artifactId>
                <version>${caf.worker-framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.github.workerframework.testing</groupId>
                <artifactId>workerframework-testing-util</artifactId>
                <version>4.0.0-267</version>
            </dependency>
            <dependency>
                <groupId>com.github.workerframework.testing</groupId>
                <artifactId>workerframework-testing-integration</artifactId>
                <version>4.0.0-267</version>
            </dependency>
            <dependency>
                <groupId>com.github.cafdataprocessing.workers.document</groupId>
                <artifactId>worker-document-shared</artifactId>
                <version>7.0.0-1496</version>
            </dependency>
            <dependency>
                <groupId>com.github.jobservice</groupId>
                <artifactId>document-message-builder</artifactId>
                <version>3.0.0-558</version>
            </dependency>
            <dependency>
                <groupId>com.github.jobservice.workers.batch</groupId>
                <artifactId>worker-batch</artifactId>
                <version>${worker-batch-version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jobservice.workers.batch</groupId>
                <artifactId>worker-batch-extensibility</artifactId>
                <version>${worker-batch-version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jobservice.workers.batch</groupId>
                <artifactId>worker-batch-testing</artifactId>
                <version>${worker-batch-version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jobservice</groupId>
                <artifactId>worker-globfilter-batch-plugin</artifactId>
                <version>2.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>jakarta.xml.bind</groupId>
                <artifactId>jakarta.xml.bind-api</artifactId>
                <version>2.3.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>worker-globfilter-batch-plugin</module>
        <module>worker-globfilter-container</module>
    </modules>
    
    <scm>
        <connection>scm:git:https://github.com/JobService/worker-globfilter.git</connection>
        <developerConnection>scm:git:https://github.com/JobService/worker-globfilter.git</developerConnection>
        <url>https://github.com/JobService/worker-globfilter</url>
    </scm>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.github.cafapi.plugins.docker.versions</groupId>
                    <artifactId>docker-versions-maven-plugin</artifactId>
                    <version>1.0.0-29</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>com.github.cafapi.plugins.docker.versions</groupId>
                <artifactId>docker-versions-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <imageManagement>
                        <image>
                            <repository>${dockerHubPublic}/cafapi/opensuse-jre17</repository>
                            <tag>4.1.0</tag>
                            <digest>sha256:ebb4816ac8b80c07f091f30104ae5710e5e624c985cfd41fafc3dbf4c631a5a9</digest>
                        </image>
                        <image>
                            <repository>${dockerHubPublic}/cloudesire/webdav</repository>
                            <tag>latest</tag>
                        </image>
                        <image>
                            <repository>${dockerHubPublic}/library/busybox</repository>
                            <tag>latest</tag>
                        </image>
                        <image>
                            <repository>${dockerHubPublic}/library/rabbitmq</repository>
                            <tag>3.6.9-management</tag>
                        </image>
                    </imageManagement>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
